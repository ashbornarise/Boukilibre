# Environment Variables Configuration
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# MongoDB Configuration (optionnel pour l'instant)
MONGODB_URI=mongodb://localhost:27017/boukilibre

# Email Configuration (à configurer plus tard)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Stripe Configuration (optionnel)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Configuration (optionnel)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Moov Money Configuration (optionnel)
MOOV_API_KEY=your_moov_api_key
MOOV_API_SECRET=your_moov_api_secret

# Mixx by Yas Configuration (optionnel)
MIXX_API_KEY=your_mixx_api_key
MIXX_API_SECRET=your_mixx_api_secret
