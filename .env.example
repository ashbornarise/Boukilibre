# Environment Variables Configuration
# Copy this file to .env and fill in your actual values. Never commit .env.

# Server Configuration
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# MongoDB Configuration (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb://localhost:27017/boukilibre

# Admin Dashboard
ADMIN_EMAIL=admin@boukilibre.com
ADMIN_PASSWORD=change-me
JWT_SECRET=change-this-to-a-long-random-string

# Vercel Blob (file storage for cover images and product files)
# Created automatically when you connect a Blob store to your Vercel project
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Email Configuration (Gmail - use an App Password, not your account password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Moov Money Configuration
MOOV_API_KEY=your_moov_api_key
MOOV_API_SECRET=your_moov_api_secret

# Mixx by Yas Configuration
MIXX_API_KEY=your_mixx_api_key
MIXX_API_SECRET=your_mixx_api_secret
